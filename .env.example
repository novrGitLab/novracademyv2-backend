# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# NextAuth (shared secret with frontend)
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Redis (optional, for BullMQ queues)
REDIS_URL=

# Cloudflare R2 (for file storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Mux (for video)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Stripe (for payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paystack (for payments)
PAYSTACK_SECRET_KEY=

# Resend (for email)
RESEND_API_KEY=

# Anthropic (for AI assistant)
ANTHROPIC_API_KEY=

# Daily.co (for live classes)
DAILY_API_KEY=

# GoPhish (for phishing simulations)
GOPHISH_URL=https://172.236.25.61:3004/api
GOPHISH_API_KEY=
GOPHISH_CAMPAIGN_URL=http://172.236.25.61:3005
GOPHISH_REDIRECT_URL=http://172.236.25.61:3006
GOPHISH_SMTP_HOST=mailhog
GOPHISH_SMTP_PORT=1025
# Real sending: set these to your SMTP relay (leave username/password empty for
# relays with no auth). FROM_ADDRESS defaults to security@novracademy.com.
GOPHISH_SMTP_FROM_ADDRESS=
GOPHISH_SMTP_USERNAME=
GOPHISH_SMTP_PASSWORD=
# GoPhish real-time events: configure a GLOBAL webhook in GoPhish (Admin → Webhooks)
# pointing at <this-api>/webhooks/gophish — GoPhish has no per-campaign webhook URL.
