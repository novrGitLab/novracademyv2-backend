{
  "name": "@novr/backend",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "npx prisma generate --schema=packages/db/prisma/schema.prisma",
    "start": "tsx index.ts",
    "typecheck": "tsc --noEmit",
    "db:seed": "npx tsx packages/db/prisma/seed.ts",
    "db:migrate": "npx prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:push": "npx prisma db push --schema=packages/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@mux/mux-node": "^9.0.1",
    "@novr/db": "file:./packages/db",
    "@novr/types": "file:./packages/types",
    "@react-email/components": "^0.0.32",
    "@react-pdf/renderer": "^4.1.6",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "jose": "^5.9.6",
    "next-auth": "^4.24.11",
    "nodemailer": "^7.0.13",
    "prisma": "^5.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^4.0.1",
    "socket.io": "^4.8.1",
    "stripe": "^17.5.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.3"
  }
}
